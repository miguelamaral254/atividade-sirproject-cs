@model SirProject.Web.DTOs.LoginDTO

@{
    ViewData["Title"] = "Login";
}

<div class="page-wrapper">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <img src="~/logo.png" alt="SirProject Logo" style="max-width: 150px; margin-bottom: 1rem;" />
                <h1>SirProject</h1>
                <p>Sistema de Gestão de Pessoas</p>
            </div>
            
            <form asp-action="Login" class="login-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Username" class="form-label">
                        <i class="fas fa-user"></i> Usuário
                    </label>
                    <input asp-for="Username" class="form-control form-control-lg" placeholder="Digite seu usuário" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label">
                        <i class="fas fa-key"></i> Senha
                    </label>
                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Digite sua senha" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="fas fa-sign-in-alt"></i> Entrar
                </button>
            </form>
            
            <div class="login-credentials mt-5 pt-4 border-top">
                <p class="text-muted small mb-2"><i class="fas fa-info-circle"></i> Credenciais de Teste:</p>
                <div class="credential-item">
                    <span class="badge bg-info">admin / admin123</span>
                    <small class="d-block text-muted">Acesso Total</small>
                </div>
                <div class="credential-item mt-2">
                    <span class="badge bg-secondary">user / user123</span>
                    <small class="d-block text-muted">Acesso Leitura</small>
                </div>
            </div>
        </div>
    </div>
</div>
