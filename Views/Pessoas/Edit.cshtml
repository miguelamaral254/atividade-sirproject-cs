@model SirProject.Web.DTOs.PessoaDTO

@{
    ViewData["Title"] = "Editar Pessoa";
}

<div class="page-wrapper">
    <div class="card-wrapper">
        <div class="card-container">
            <div class="card-header">
                <i class="fas fa-user-edit"></i>
                <h1>Editar Pessoa</h1>
            </div>

            <form asp-action="Edit" enctype="multipart/form-data" class="person-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagePath" />

                <div class="form-group">
                    <label asp-for="Name" class="form-label">
                        <i class="fas fa-user"></i> Nome Completo
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="Digite o nome" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope"></i> E-mail
                    </label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Digite o e-mail" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Phone" class="form-label">
                        <i class="fas fa-phone"></i> Telefone
                    </label>
                    <input asp-for="Phone" class="form-control" placeholder="Digite o telefone" oninput="AppUtils.applyPhoneMask(this)" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BirthDate" class="form-label">
                        <i class="fas fa-birthday-cake"></i> Data de Nascimento
                    </label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ImageFile" class="form-label">
                        <i class="fas fa-image"></i> Foto (opcional)
                    </label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="current-image">
                            <p class="text-muted small">Foto atual:</p>
                            <img src="@Model.ImagePath" alt="Pessoa Image" class="detail-image" />
                        </div>
                    }
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Salvar Alterações
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
