@using SirProject.Core.Pagination
@model PaginatedList<SirProject.Core.Entities.User>

@{
    ViewData["Title"] = "Usuários";
}

<div class="grid-container">
    <div class="grid-card">
        <div class="grid-header">
            <i class="fas fa-user-shield"></i>
            <h1>Gestão de Usuários</h1>
            <p>Gerenciar cadastro de usuários do sistema</p>
        </div>

        <div class="grid-toolbar">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Adicionar Usuário
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 40%">Usuário</th>
                        <th style="width: 30%">Função (Role)</th>
                        <th style="width: 30%">Ações</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Username)
                        </td>
                        <td>
                            @item.Role
                        </td>
                        <td class="actions-cell">
                            <a asp-action="Edit" asp-route-id="@item.Id" title="Editar" class="icon-btn icon-edit"><i class="fas fa-pencil-alt"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" title="Deletar" class="icon-btn icon-delete" onclick="return confirm('Tem certeza que deseja deletar?');"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>

        <nav aria-label="Navegação de páginas">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize">Próximo</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
